def twosum(num,target):
    left = 0
    right = len(num) - 1
    while left < right:
        current_sum = num[left] + num[right]
        if current_sum == target:
            return (left + 1, right + 1)
        elif current_sum < target:
            left += 1
        else:
            right -= 1
    return None



# Test Cases
print(twosum([1, 2, 3, 4, 5], 6))  # Output: (1, 3)
print(twosum([2, 4, 6, 8, 10], 12))  # Output: (1, 4)
print(twosum([1, 3, 5, 7, 9], 10))  # Output: (0, 4)
print(twosum([1, 2, 3, 4, 5], 10))  # Output: None